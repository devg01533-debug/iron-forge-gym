# ============================================================
# Environment Variables - Gym Lead Capture Platform
# ============================================================

# n8n Webhook URL (REQUIRED - update with your n8n instance URL)
# Example: https://your-n8n-instance.com/webhook/gym-lead-capture
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/gym-lead-capture

# Claude API Key (for AI Agent in n8n)
CLAUDE_API_KEY=sk-ant-xxxxx

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/gym_leads
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# n8n Configuration
N8N_HOST=http://localhost:5678
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_MCP_TOKEN=your-n8n-mcp-token

# Site Configuration
SITE_URL=https://ironforgegym.netlify.app
SITE_NAME=Iron Forge Gym
SUPPORT_EMAIL=support@ironforgegym.com
